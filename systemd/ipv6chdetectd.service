[Unit]
Description=Apply IPv6 configuration changes through package hooks
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/ipv6chdetectd
Restart=on-failure
RestartSec=3
StateDirectory=iserv/ipv6chdetectd
StateDirectoryMode=0700
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
